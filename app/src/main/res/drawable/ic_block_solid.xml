<!--
    Дорожный «кирпич» — «Запрет приложений».

    Объёмная иконка: градиенты + блики вместо плоской заливки (см.
    docs/ui-concepts/icons-volumetric/icons-mockup.html).
    ВАЖНО: показывать через Image(painterResource(...)), а НЕ Icon — tint у Icon
    красит содержимое одним цветом и убивает градиенты.
    Теней нет: VectorDrawable не поддерживает feDropShadow, объём держится на градиентах.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="96"
    android:viewportHeight="96">

    <path
        android:pathData="M8,48 a40,40 0 1,0 80,0 a40,40 0 1,0 -80,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="8"
                android:startY="8"
                android:endX="88"
                android:endY="88">
                <item android:offset="0" android:color="#FFF6B0AB"/>
                <item android:offset=".5" android:color="#FFD1544E"/>
                <item android:offset="1" android:color="#FF8E2F2A"/>
            </gradient>
        </aapt:attr>
    </path>
    <path
        android:pathData="M8,48 a40,40 0 1,0 80,0 a40,40 0 1,0 -80,0 Z"
        android:fillColor="#00000000"
        android:strokeColor="#FF5E1F1B"
        android:strokeAlpha="0.35"
        android:strokeWidth="3" />
    <group android:rotation="-28" android:pivotX="34" android:pivotY="30">
        <path
            android:pathData="M19,30 a15,9 0 1,0 30,0 a15,9 0 1,0 -30,0 Z"
            android:fillColor="#FFFFFFFF"
            android:fillAlpha="0.28" />
    </group>
    <path
        android:pathData="M26,42 h44 a4,4 0 0,1 4,4 v10 a4,4 0 0,1 -4,4 h-44 a4,4 0 0,1 -4,-4 v-10 a4,4 0 0,1 4,-4 Z"
        android:fillColor="#FF5E1F1B"
        android:fillAlpha="0.38" />
    <path
        android:pathData="M26,39 h44 a4,4 0 0,1 4,4 v10 a4,4 0 0,1 -4,4 h-44 a4,4 0 0,1 -4,-4 v-10 a4,4 0 0,1 4,-4 Z"
        android:fillColor="#FFFFF6F5" />
    <path
        android:pathData="M25.5,39 h45 a3.5,3.5 0 0,1 3.5,3.5 v0 a3.5,3.5 0 0,1 -3.5,3.5 h-45 a3.5,3.5 0 0,1 -3.5,-3.5 v0 a3.5,3.5 0 0,1 3.5,-3.5 Z"
        android:fillColor="#FFFFFFFF"
        android:fillAlpha="0.55" />
</vector>
