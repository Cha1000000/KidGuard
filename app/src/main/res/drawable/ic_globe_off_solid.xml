                android:type="linear"
                android:startX="10"
                android:startY="10"
                android:endX="86"
                android:endY="86">
                <item android:offset="0" android:color="#FFCFE3E6"/>
                <item android:offset="1" android:color="#FF6E8D95"/>
            </gradient>
        </aapt:attr>
    </path>
    <path
