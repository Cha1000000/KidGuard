<!--
    Галочка в круге — «Всегда доступные».

    Объёмная иконка: градиенты + блики вместо плоской заливки (см.
    docs/ui-concepts/icons-volumetric/icons-mockup.html).
    ВАЖНО: показывать через Image(painterResource(...)), а НЕ Icon — tint у Icon
    красит содержимое одним цветом и убивает градиенты.
    Теней нет: VectorDrawable не поддерживает feDropShadow, объём держится на градиентах.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="96"
    android:viewportHeight="96">

    <path
        android:pathData="M8,48 a40,40 0 1,0 80,0 a40,40 0 1,0 -80,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="8"
                android:startY="8"
                android:endX="88"
                android:endY="88">
                <item android:offset="0" android:color="#FFBFEDE5"/>
                <item android:offset=".55" android:color="#FF57B0AE"/>
                <item android:offset="1" android:color="#FF2B7C84"/>
            </gradient>
        </aapt:attr>
    </path>
    <path
        android:pathData="M17,48 a31,31 0 1,0 62,0 a31,31 0 1,0 -62,0 Z"
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeAlpha="0.22"
        android:strokeWidth="2" />
    <path
        android:pathData="M30 49 L43 62 L67 34"
        android:fillColor="#00000000"
        android:strokeColor="#FF0E3B33"
        android:strokeAlpha="0.25"
        android:strokeWidth="10"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M30 49 L43 62 L67 34"
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="9"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <group android:rotation="-28" android:pivotX="34" android:pivotY="30">
        <path
            android:pathData="M19,30 a15,9 0 1,0 30,0 a15,9 0 1,0 -30,0 Z"
            android:fillColor="#FFFFFFFF"
            android:fillAlpha="0.3" />
    </group>
</vector>
