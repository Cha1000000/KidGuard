    <path
        android:pathData="M30,42 h36 a12,12 0 0,1 12,12 v22 a12,12 0 0,1 -12,12 h-36 a12,12 0 0,1 -12,-12 v-22 a12,12 0 0,1 12,-12 Z">
        <aapt:attr name="android:fillColor">
            <gradient
