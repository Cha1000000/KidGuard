<?xml version="1.0" encoding="utf-8"?>
<!--
    Копилка с монетой — иконка экрана «Поддержать проект».

    Почему копилка, а не сердце: экран про добровольный денежный вклад, а сердце говорило бы
    об отношении к приложению. Пропорции по канону таких иконок: тело почти круглое, морда
    выступает отдельной «ступенькой», пятачок смотрит вперёд в профиль. Гамма та же, что у иконки
    приложения (бирюза + золото), чтобы иконка выглядела родной.

    Теней нет: VectorDrawable не поддерживает feDropShadow. Объём держится на градиентах и бликах.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="120"
    android:viewportHeight="120">

    <!-- Ножки. Рисуются до тела, чтобы верх ушёл под него. -->
    <path
        android:pathData="M32,86 h11 v14 a3,3 0 0,1 -3,3 h-5 a3,3 0 0,1 -3,-3 Z"
        android:fillColor="#FF2B7C84" />
    <path
        android:pathData="M70,86 h11 v14 a3,3 0 0,1 -3,3 h-5 a3,3 0 0,1 -3,-3 Z"
        android:fillColor="#FF2B7C84" />

    <!-- Хвостик-завиток: сзади, до тела, чтобы основание ушло под корпус. -->
    <path
        android:pathData="M26,58 c-8,-3 -13,1 -12,6 c1,4 7,5 8,1 c1,-3 -1,-5 -3,-4"
        android:strokeColor="#FF9BDCD3"
        android:strokeWidth="3.2"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- Морда: выступ со «ступенькой» перед пятачком — та деталь, без которой свинка
         читается просто как овал с наростом сбоку. Рисуется до тела и сливается с ним. -->
    <path android:pathData="M74,54 h18 c5,0 8,4 8,9 v10 c0,5 -3,9 -8,9 h-18 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="74" android:startY="54"
                android:endX="100" android:endY="82">
                <item android:offset="0" android:color="#FF9FDDD5" />
                <item android:offset="1" android:color="#FF3B8F94" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Тело: почти круглое, как у канонических копилок -->
    <path android:pathData="M22,64 a34,30 0 1,0 68,0 a34,30 0 1,0 -68,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="30" android:startY="38"
                android:endX="86" android:endY="92">
                <item android:offset="0" android:color="#FFB4E8E0" />
                <item android:offset="0.55" android:color="#FF57B0AE" />
                <item android:offset="1" android:color="#FF2B7C84" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Ухо-лепесток, наклонённое вперёд к пятачку. Основание лежит на линии верха головы. -->
    <path
        android:pathData="M68,42 C71,33 76,28 81,31 C82,37 81,43 80,49 Z"
        android:strokeColor="#FF1E5F68"
        android:strokeWidth="1.8">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="68" android:startY="30"
                android:endX="81" android:endY="49">
                <item android:offset="0" android:color="#FFCDF0EA" />
                <item android:offset="1" android:color="#FF5FB3B2" />
            </gradient>
        </aapt:attr>
    </path>
    <path
        android:pathData="M72,41 C74,36 77,33 80,35 C80,39 79,43 78,46 Z"
        android:fillColor="#FFE3F7F2"
        android:fillAlpha="0.55" />

    <!-- Глаз -->
    <path
        android:pathData="M76,58 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0 Z"
        android:fillColor="#0A161A"
        android:fillAlpha="0.6" />

    <!-- Прорезь для монеты -->
    <path
        android:pathData="M45,40 h20 a2.5,2.5 0 0,1 0,5 h-20 a2.5,2.5 0 0,1 0,-5 Z"
        android:fillColor="#0A161A"
        android:fillAlpha="0.45" />

    <!-- Крупный глянцевый блик сверху слева — главный источник объёма -->
    <path
        android:pathData="M30,56 a14,9 0 1,0 28,0 a14,9 0 1,0 -28,0 Z"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.18" />
    <path
        android:pathData="M34,50 a7,4 0 1,0 14,0 a7,4 0 1,0 -14,0 Z"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.22" />

    <!-- Монета над прорезью -->
    <path android:pathData="M41,16 a14,14 0 1,0 28,0 a14,14 0 1,0 -28,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="43" android:startY="4"
                android:endX="67" android:endY="28">
                <item android:offset="0" android:color="#FFFFE08A" />
                <item android:offset="0.5" android:color="#FFF0B03F" />
                <item android:offset="1" android:color="#FFB87A1C" />
            </gradient>
        </aapt:attr>
    </path>
    <path
        android:pathData="M47,11 a5,3.5 0 1,0 10,0 a5,3.5 0 1,0 -10,0 Z"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.55" />

</vector>
