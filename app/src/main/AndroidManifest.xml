<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Разрешения платформенных функций объявлены в модуле :platform (мёрж манифестов). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        allowBackup=false осознанно: это приложение родительского контроля. При включённом
        бэкапе данные приложения (политики, состояние PIN-защиты) можно вытащить и подложить
        обратно через adb backup/restore — то есть обойти ограничения, не имея root.
        Цена решения: настройки не переезжают на новый телефон, их нужно задать заново;
        для родительского контроля это правильный размен.
    -->
    <application
        android:name=".KidGuardApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.KidGuard">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.KidGuard"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
