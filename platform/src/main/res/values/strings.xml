    <string name="pin_overlay_title">Введите PIN</string>
    <string name="pin_overlay_subtitle">Эту настройку защитил родитель</string>
    <!-- Тот же PIN-оверлей, но для обхода блокирующего экрана (лимит/учёба/запрет) -->
    <string name="pin_overlay_bypass_subtitle">PIN родителя снимет это ограничение</string>
    <string name="pin_overlay_wrong">Неверный PIN</string>
    <string name="pin_overlay_blocked">Слишком много попыток. Повторите через %1$d с</string>
    <string name="pin_overlay_back">Назад</string>
    <string name="pin_overlay_backspace_glyph">⌫</string>
    <string name="pin_overlay_dot_glyph">●</string>

    <!-- Контроль потерял разрешение «Специальные возможности»: предупреждение, затем замок -->
    <string name="warning_control_lost_title">Контроль отключён</string>
    <string name="warning_control_lost_text">Включите заново разрешение «Специальные возможности», иначе телефон заблокируется через %1$d мин</string>
    <string name="control_lock_title">Телефон заблокирован</string>
    <!-- «Выключите и включите заново» — не лишние слова: сервис мог упасть при живом разрешении,
