    <string name="control_lock_subtitle">KidGuard не работает: разрешение «Специальные возможности» отключилось. Включите его заново — если тумблер уже включён, выключите и включите. Блокировка снимется сама.</string>
    <string name="control_lock_action">Включить разрешение</string>

    <!-- Warning-оверлей при попытке включить «Блокировать соединения без VPN» -->
    <string name="lockdown_warning_title">Не включайте эту опцию</string>
    <string name="lockdown_warning_message">Опция «Блокировать соединения без VPN» вместе с запретом сайтов оставит телефон совсем без интернета. Поэтому KidGuard не даёт её включить. На остальную защиту это не влияет.</string>
    <string name="lockdown_warning_ok">Понятно</string>

    <!-- Ночной замок «Время сна»: несмахиваемый экран, снимается только родительским PIN -->
    <string name="sleep_lock_title">Время сна</string>
    <string name="sleep_lock_until">Телефон откроется в %1$s</string>
    <string name="sleep_lock_hint">Экран закроется, когда родитель введёт PIN</string>
    <string name="sleep_lock_call">Позвонить %1$s</string>

    <!-- Замок принудительного перерыва: тот же несмахиваемый экран, но с обратным отсчётом -->
    <string name="break_lock_title">Перерыв</string>
    <string name="break_lock_hint">Экран откроется сам. Родитель может снять его PIN-ом.</string>
    <string name="break_lock_default_message">Сделай перерыв! Дай глазам отдохнуть</string>
    <string name="break_warning_title">Перерыв через 5 минут</string>
    <string name="break_warning_subtitle">Успей сохраниться</string>

    <!-- Device Admin (веха 6.3) -->
    <string name="device_admin_disable_warning">Отключение защитит телефон от KidGuard-контроля. Для отключения нужен родительский PIN.</string>
