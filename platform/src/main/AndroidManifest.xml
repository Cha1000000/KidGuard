<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Разрешения платформенных функций (специальные — выдаются через системные экраны). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!--
        Самовосстановление accessibility (см. PermissionsManager.restoreAccessibility). Система
        обычному приложению это разрешение НЕ выдаёт — объявление нужно лишь затем, чтобы его можно
        было выдать разово с компьютера:
        adb shell pm grant ru.homelab.kidguard android.permission.WRITE_SECURE_SETTINGS
        Без него всё работает по-прежнему, просто разрешение придётся возвращать руками.
    -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Прямой звонок с ночного замка по номеру, заданному родителем. Не выдано —
         кнопка откатывается на ACTION_DIAL, функция не ломается. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application>

        <!-- Accessibility-сервис: детект активного приложения и блокирующие оверлеи. -->
        <service
            android:name="ru.homelab.kidguard.platform.accessibility.KidGuardAccessibilityService"
            android:exported="false"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Device Admin: защита приложения от удаления (НЕ Device Owner). -->
        <receiver
            android:name="ru.homelab.kidguard.platform.deviceadmin.KidGuardDeviceAdminReceiver"
            android:description="@string/device_admin_description"
            android:exported="false"
            android:label="@string/device_admin_label"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_policies" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Foreground-сервис контроля (учёт времени, блокировка). Тип specialUse —
             родительский контроль не подходит под штатные типы FGS. -->
        <service
            android:name="ru.homelab.kidguard.platform.foreground.KidGuardForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="parental_control" />
        </service>

        <!-- Blackhole-VPN (веха 5): режет интернет всем, кроме KidGuard и белого списка, когда
             общий дневной лимит исчерпан. Поднимается/снимается VpnController. -->
        <service
            android:name="ru.homelab.kidguard.platform.vpn.KidGuardVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="parental_control" />
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!--
            Автозапуск сервиса после перезагрузки И после обновления приложения (только на детском
            устройстве) — см. BootReceiver. Без второго броадкаста контроль лежал бы после каждого
            обновления из магазина, пока ребёнок сам не откроет приложение.

            android:permission намеренно НЕ ставим: он требует разрешение от ОТПРАВИТЕЛЯ, а оба
            броадкаста protected — их шлёт только система, подделать их нельзя. Прежний
            RECEIVE_BOOT_COMPLETED тут ничего не защищал, зато мог молча отсечь MY_PACKAGE_REPLACED,
            то есть ровно тот случай, ради которого ресивер и правится.
        -->
        <receiver
            android:name="ru.homelab.kidguard.platform.foreground.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
